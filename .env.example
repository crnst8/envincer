# Copy to .env. All keys are optional; envincer runs without an LLM (keyword rules instead).

# OpenCode Go key for planning, plain-English adjustments, AI review and preset drafts.
# Generate a key dedicated to envincer in the OpenCode console.
OPENCODE_API_KEY=
# Model id from https://opencode.ai/docs/go. The wire format is picked from the name;
# set ENVINCER_MODEL_API to messages | responses | chat to override.
ENVINCER_MODEL=claude-haiku-5-5
ENVINCER_MODEL_API=
OPENCODE_BASE_URL=https://opencode.ai/inference/go

# Server. HOST is a comma-separated list; empty = 127.0.0.1 plus the tailscale0 address.
PORT=4190
HOST=
# When set, the UI and API ask for HTTP Basic auth (any username, this password).
ENVINCER_PASSWORD=

# Runtime
ENVINCER_DATA=
ENVINCER_CONCURRENCY=2
ENVINCER_VIEWER_DPR=2
CHROMIUM_PATH=/usr/bin/chromium
TESSERACT_PATH=tesseract
